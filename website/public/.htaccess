# =====================================================================
# public/.htaccess – aktiv, wenn public/ der Document Root ist
# =====================================================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS erzwingen
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Kanonische Domain: www
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteCond %{HTTP_HOST} !^$
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Alte URLs per PHP-Redirect-Map (config/redirects.php) -> index.php

    # Front-Controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Sicherheitsoptionale Header
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

# Browser-Caching für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 180 days"
    ExpiresByType image/webp "access plus 180 days"
    ExpiresByType image/avif "access plus 180 days"
    ExpiresByType image/png "access plus 180 days"
    ExpiresByType image/jpeg "access plus 180 days"
    ExpiresByType image/ico "access plus 180 days"
    ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
